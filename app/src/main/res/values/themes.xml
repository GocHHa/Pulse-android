<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme. Compose draws everything; this only sets a near-black window so the
         app never flashes white while starting, and so the splash screen matches. -->
    <style name="Theme.Pulse" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/pulse_background</item>
        <item name="android:colorBackground">@color/pulse_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
