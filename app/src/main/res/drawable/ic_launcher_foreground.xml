<?xml version="1.0" encoding="utf-8"?>
<!-- Pulse adaptive icon foreground: a 270° instrument gauge with a heartbeat trace.
     Everything important sits inside the 66dp safe zone (radius 33 around the center). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Gauge track -->
    <path
        android:pathData="M35.615,72.385 A26,26 0 1,1 72.385,72.385"
        android:strokeWidth="5"
        android:strokeColor="#FF1F2A33"
        android:strokeLineCap="round" />

    <!-- Gauge progress (green to cyan) -->
    <path
        android:pathData="M35.615,72.385 A26,26 0 1,1 76.38,40.77"
        android:strokeWidth="5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="30"
                android:startY="74"
                android:endX="80"
                android:endY="36">
                <item android:offset="0.0" android:color="#FF3DF5A0" />
                <item android:offset="1.0" android:color="#FF22D3EE" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Needle tip -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M76.38,40.77 m-3.2,0 a3.2,3.2 0 1,0 6.4,0 a3.2,3.2 0 1,0 -6.4,0" />

    <!-- Heartbeat trace -->
    <path
        android:pathData="M33,57 L43,57 L47.5,48 L53,66 L58.5,42 L63,57 L75,57"
        android:strokeWidth="4"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
